/* Wisp Enterprise TUI — Application Shell Layout */

Screen {
    background: #0d1117;
    color: #e6edf3;
}

#title-bar {
    dock: top;
    height: 1;
    background: #161b22;
    border-bottom: solid #30363d;
}

#title-bar .app-name {
    color: #58a6ff;
    text-style: bold;
}

#title-bar .separator {
    color: #484f58;
}

#title-bar .info-text {
    color: #8b949e;
}

#status-bar {
    dock: bottom;
    height: 1;
    background: #161b22;
    border-top: solid #30363d;
    color: #8b949e;
}

#status-bar .key-hint {
    color: #484f58;
}

#activity-bar {
    dock: left;
    width: 4;
    background: #0d1117;
    border-right: solid #30363d;
    padding: 0 1;
}

#activity-bar .icon-button {
    width: 2;
    height: 3;
    content-align: center middle;
}

#activity-bar .icon-button:hover {
    background: #21262d;
}

#activity-bar .icon-button.active {
    background: #0c2d6b;
    border-left: solid #58a6ff;
}

#body {
    height: 1fr;
}

#primary-panel {
    width: 1fr;
    border-right: solid #21262d;
}

#context-panel {
    width: 30%;
    background: #0d1117;
    border-left: solid #30363d;
}

#context-panel.hidden {
    width: 0;
    border: none;
}

TabbedContent {
    height: 1fr;
}

TabbedContent > ContentSwitcher {
    height: 1fr;
}

TabPane {
    background: #0d1117;
    padding: 0;
}

#command-palette {
    width: 60%;
    height: 50%;
    border: solid #58a6ff;
    background: #21262d;
    padding: 1 2;
    align: center middle;
    overlay: screen;
}

#command-palette Input {
    width: 100%;
    background: #21262d;
    border: solid #30363d;
    color: #e6edf3;
}

#command-palette ListView {
    height: 1fr;
    margin-top: 1;
    background: #0d1117;
}

#input-bar {
    dock: bottom;
    height: auto;
    min-height: 1;
    max-height: 8;
    background: #21262d;
    border-top: solid #30363d;
    padding: 0 2;
}

#input-bar Input {
    width: 1fr;
    background: #21262d;
    color: #e6edf3;
}

.label-accent { color: #58a6ff; }
.label-green { color: #3fb950; }
.label-red { color: #f85149; }
.label-yellow { color: #d29922; }
.label-purple { color: #a371f7; }
.label-muted { color: #484f58; }
.info-text { color: #8b949e; }
.pane-title { text-style: bold; color: #e6edf3; margin-bottom: 1; }

.card {
    background: #161b22;
    border: solid #30363d;
    padding: 1 2;
    margin-bottom: 1;
}
.card:hover { border: solid #58a6ff; }

/* ── Splash Screen ── */
SplashScreen {
    align: center middle;
}

SplashScreen .app-name {
    color: #58a6ff;
    text-style: bold;
    content-align: center middle;
    width: 100%;
}

SplashScreen Vertical {
    /* No width:auto here: children are width:1fr, and auto-parent with
       fr-children is circular under textual 8.x — everything measures
       0x0 and the whole screen renders blank. Default 1fr width works. */
    height: auto;
    align: center middle;
    content-align: center middle;
}

SplashScreen .info-text {
    content-align: center middle;
    width: 100%;
    margin-top: 1;
}

/* ── Session Picker Screen ── */
SessionPickerScreen {
    align: center top;
}

SessionPickerScreen > Vertical {
    width: 100%;
    height: 100%;
    padding: 2 4;
}

#session-search {
    width: 100%;
    margin: 1 0;
    background: #21262d;
    border: solid #30363d;
    color: #e6edf3;
}

#session-list {
    height: 1fr;
    background: #0d1117;
    border: solid #21262d;
}

#sessions {
    height: 1fr;
}

#sessions ListItem {
    padding: 0 1;
}

#sessions ListItem:hover {
    background: #1c2128;
}

#sessions .--highlight {
    background: #0c2d6b;
    border-left: solid #58a6ff;
}
