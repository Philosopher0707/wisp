+    def generate_stream_events_async(
+        self,
+        system_prompt: str,
+        messages: list[dict],
+        tools: Optional[list] = None,
+        checkpoint_every: int = 50,
+    ):
+        """Async streaming - wraps sync generator in thread."""
+        import asyncio
+        import threading
+
+        if self._client is not None:
+            sync_gen = self._client.generate_stream_events(system_prompt, messages, tools, checkpoint_every)
+        else:
+            sync_gen = self._generate_stream_events_direct(system_prompt, messages, tools)
+
+        loop = asyncio.get_running_loop()
+        queue: asyncio.Queue[dict] = asyncio.Queue()
+        done = object()
+        cancelled = threading.Event()
+
+        def _sync_producer():
+            try:
+                for event in sync_gen:
+                    if cancelled.is_set():
+                        break
+                    loop.call_soon_threadsafe(queue.put_nowait, event)
+                loop.call_soon_threadsafe(queue.put_nowait, done)
+            except Exception:
+                loop.call_soon_threadsafe(queue.put_nowait, done)
+                raise
+
+        thread = threading.Thread(target=_sync_producer, daemon=True)
+        thread.start()
+
+        async def _async_generator():
+            try:
+                while True:
+                    event = await queue.get()
+                    if event is done:
+                        break
+                    yield event
+            finally:
+                cancelled.set()
+                while not queue.empty():
+                    try:
+                        queue.get_nowait()
+                    except Exception:
+                        break
+                thread.join(timeout=5.0)
+
+        return _async_generator()
+
+    def generate_structured(
+        self,
+        system_prompt: str,
+        messages: list[dict],
+        output_schema: dict[str, Any],
+    ) -> dict[str, Any]:
+        """Generate structured output using Ollama's format=json feature."""
+        import json
+
+        payload = {
+            "model": self.model,
+            "messages": [{"role": "system", "content": system_prompt}] + messages,
+            "format": json.dumps(output_schema),
+            "stream": False,
+        }
+
+        resp = self._post("/api/chat", payload)
+        if resp.get("message", {}).get("content"):
+            try:
+                return json.loads(resp["message"]["content"])
+            except json.JSONDecodeError:
+                pass
+        return {"error": "Failed to generate valid JSON"}
+
