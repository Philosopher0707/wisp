    {"id":"key-title","type":"text","x":1090,"y":515,"width":260,"height":20,"text":"KEY ARCHITECTURAL DECISIONS","fontSize":11,"fontFamily":1,"textAlign":"center","verticalAlign":"middle","strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":0,"roughness":0,"opacity":100,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false},
