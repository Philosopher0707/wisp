    {"id":"svc-reg","type":"text","x":1100,"y":310,"width":240,"height":60,"text":"ServiceRegistry\n• registers all services in dep order\n• start() calls all in order\n• stop() calls all in reverse\n• health() aggregates status","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":0,"roughness":0,"opacity":100,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false},
    {"id":"svc-deps","type":"text","x":1100,"y":410,"width":240,"height":80,"text":"Dependency order:\n1. Config\n2. Repository, ProviderPool\n3. ExtensionRegistry\n4. Domain Services\n5. Transports\n\nStop order is reversed.","fontSize":11,"fontFamily":1,"textAlign":"left","verticalAlign":"middle","strokeColor":"#495057","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":0,"roughness":0,"opacity":100,"roundness":null,"boundElements":null,"updated":1,"link":null,"locked":false},

