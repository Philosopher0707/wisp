Step 2: Add Wisp to OSC 777 listener support

app/src/terminal/cli_agent_sessions/listener/mod.rs:
@@
 pub fn is_agent_supported(agent: &CLIAgent) -> bool {
     matches!(
         agent,
         CLIAgent::Claude
             | CLIAgent::OpenCode
             | CLIAgent::Codex
             | CLIAgent::Gemini
             | CLIAgent::Auggie
+            | CLIAgent::Wisp
     )
 }
 @@
 fn create_handler(agent: &CLIAgent) -> Option<Box<dyn CLIAgentSessionHandler>> {
     match agent {
         CLIAgent::Claude | CLIAgent::OpenCode | CLIAgent::Gemini | CLIAgent::Auggie | CLIAgent::Wisp => {
             Some(Box::new(DefaultSessionListener))
         }
         CLIAgent::Codex => Some(Box::new(CodexSessionHandler)),
         _ => None,
     }
 }

