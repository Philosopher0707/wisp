From b5620467dc82959c7423fa1d4aebeaef3e750ac1 Mon Sep 17 00:00:00 2001
From: Wisp Contributors <wisp@wisp.dev>
Date: Thu, 30 Apr 2026 18:09:41 +0530
Subject: [PATCH] feat: add Wisp as a recognized CLI agent
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Wisp is an open-source, local-first coding agent powered by Ollama.
It serves as a community alternative to cloud-based agents.

This commit adds Wisp to Warp's CLI agent detection system:
- Adds Wisp variant to CLIAgent enum
- Registers 'wisp' command prefix for detection
- Adds Wisp brand color (#6366F1 indigo/violet)
- Maps WispLogo icon
- Enables .agents/skills/ skill provider support
- Adds Wisp SVG logo asset

When users run 'wisp' in Warp's terminal, the agent toolbelt
will now activate with full native support — rich input editor,
code review panel, vertical tab metadata, and session sharing.

See: https://github.com/wisp/wisp
---
 app/assets/bundled/svg/wisp.svg  |  8 ++++++++
 app/src/terminal/cli_agent.rs    | 20 ++++++++++++++++++--
 crates/warp_core/src/ui/icons.rs |  2 ++
 3 files changed, 28 insertions(+), 2 deletions(-)
 create mode 100644 app/assets/bundled/svg/wisp.svg

diff --git a/app/assets/bundled/svg/wisp.svg b/app/assets/bundled/svg/wisp.svg
new file mode 100644
index 0000000..c8be85c
--- /dev/null
+++ b/app/assets/bundled/svg/wisp.svg
@@ -0,0 +1,8 @@
+<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
+  <!-- Wisp: a stylized "W" with a terminal cursor accent -->
+  <path d="M3 4L9 12L3 20" stroke="#6366F1" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
+  <path d="M11 4L17 12L11 20" stroke="#818CF8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
+  <path d="M19 4L21 12L19 20" stroke="#A5B4FC" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
+  <!-- Terminal cursor blink -->
+  <rect x="21" y="16" width="2" height="4" rx="1" fill="#6366F1" opacity="0.6"/>
+</svg>
diff --git a/app/src/terminal/cli_agent.rs b/app/src/terminal/cli_agent.rs
index 91d890c..0026f8c 100644
--- a/app/src/terminal/cli_agent.rs
+++ b/app/src/terminal/cli_agent.rs
@@ -103,7 +103,15 @@ const CURSOR_COLOR: ColorU = ColorU {
     a: 255,
 };
 
-/// Represents a CLI agent (e.g., Claude Code, Gemini CLI, Codex, Amp, Droid, OpenCode, Copilot, Pi, Auggie, Cursor)
+/// Wisp brand color — indigo/violet (#6366F1)
+const WISP_COLOR: ColorU = ColorU {
+    r: 99,
+    g: 102,
+    b: 241,
+    a: 255,
+};
+
+/// Represents a CLI agent (e.g., Claude Code, Gemini CLI, Codex, Amp, Droid, OpenCode, Copilot, Pi, Auggie, Cursor, Wisp)
 #[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Sequence, Serialize, Deserialize)]
 pub enum CLIAgent {
     Claude,
@@ -116,6 +124,7 @@ pub enum CLIAgent {
     Pi,
     Auggie,
     CursorCli,
+    Wisp,
     /// Represents an unknown/custom CLI agent matched by user-configured regex patterns.
     Unknown,
 }
@@ -134,6 +143,7 @@ impl CLIAgent {
             CLIAgent::Pi => "pi",
             CLIAgent::Auggie => "auggie",
             CLIAgent::CursorCli => "agent",
+            CLIAgent::Wisp => "wisp",
             CLIAgent::Unknown => "",
         }
     }
@@ -164,6 +174,7 @@ impl CLIAgent {
             CLIAgent::Pi => "Pi",
             CLIAgent::Auggie => "Auggie",
             CLIAgent::CursorCli => "Cursor",
+            CLIAgent::Wisp => "Wisp",
             CLIAgent::Unknown => "CLI Agent",
         }
     }
@@ -181,6 +192,7 @@ impl CLIAgent {
             CLIAgent::Pi => Some(Icon::PiLogo),
             CLIAgent::Auggie => Some(Icon::AuggieLogo),
             CLIAgent::CursorCli => Some(Icon::CursorLogo),
+            CLIAgent::Wisp => Some(Icon::WispLogo),
             CLIAgent::Unknown => None,
         }
     }
@@ -208,6 +220,7 @@ impl CLIAgent {
             CLIAgent::Pi => &[SkillProvider::Agents],
             CLIAgent::Auggie => &[SkillProvider::Agents],
             CLIAgent::CursorCli => &[SkillProvider::Agents],
+            CLIAgent::Wisp => &[SkillProvider::Agents],
             CLIAgent::Unknown => &[],
         }
     }
@@ -247,6 +260,7 @@ impl CLIAgent {
             CLIAgent::Pi => Some(PI_COLOR),
             CLIAgent::Auggie => Some(AUGGIE_COLOR),
             CLIAgent::CursorCli => Some(CURSOR_COLOR),
+            CLIAgent::Wisp => Some(WISP_COLOR),
             CLIAgent::Unknown => None,
         }
     }
@@ -255,7 +269,9 @@ impl CLIAgent {
     /// Agents with light brand colors use a dark icon for contrast.
     pub fn brand_icon_color(&self) -> ColorU {
         match self {
-            CLIAgent::Pi | CLIAgent::Auggie | CLIAgent::Droid => ColorU::new(0, 0, 0, 255),
+            CLIAgent::Pi | CLIAgent::Auggie | CLIAgent::Droid | CLIAgent::Wisp => {
+                ColorU::new(0, 0, 0, 255)
+            }
             _ => ColorU::white(),
         }
     }
diff --git a/crates/warp_core/src/ui/icons.rs b/crates/warp_core/src/ui/icons.rs
index 87192ba..c769b38 100644
--- a/crates/warp_core/src/ui/icons.rs
+++ b/crates/warp_core/src/ui/icons.rs
@@ -279,6 +279,7 @@ pub enum Icon {
     PiLogo,
     AuggieLogo,
     CursorLogo,
+    WispLogo,
     NLD,
     Oz,
     OzCloud,
@@ -586,6 +587,7 @@ impl From<Icon> for &'static str {
             Icon::PiLogo => "bundled/svg/pi.svg",
             Icon::AuggieLogo => "bundled/svg/auggie.svg",
             Icon::CursorLogo => "bundled/svg/cursor.svg",
+            Icon::WispLogo => "bundled/svg/wisp.svg",
             Icon::NLD => "bundled/svg/nld.svg",
             Icon::Oz => "bundled/svg/oz.svg",
             Icon::OzCloud => "bundled/svg/oz-cloud.svg",
-- 
