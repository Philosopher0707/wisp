    {
      "type": "text",
      "id": "t_notes",
      "x": 80,
      "y": 800,
      "width": 960,
      "height": 120,
      "text": "Key flows:\n- Desktop: Renderer -> Main (IPC) -> Rust (JSON-RPC stdio)\n- Web: Browser -> HTTP/SSE -> Cloud worker -> Rust (stdio inside container)\n- TUI: Direct Rust thread, migrating to in-process App Server\n- All surfaces share codex-core agent loop",
      "fontSize": 16,
      "fontFamily": 1,
      "strokeColor": "#495057",
      "originalText": "Key flows:\n- Desktop: Renderer -> Main (IPC) -> Rust (JSON-RPC stdio)\n- Web: Browser -> HTTP/SSE -> Cloud worker -> Rust (stdio inside container)\n- TUI: Direct Rust thread, migrating to in-process App Server\n- All surfaces share codex-core agent loop",
      "autoResize": true
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff"
